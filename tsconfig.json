{
	"compilerOptions": {
		"target": "es2024",
		"module": "preserve",
		"jsx": "preserve",
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["next-env.d.ts", "app/**/*", "src/**/*", "**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules"]
}
