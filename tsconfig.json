{
	"compilerOptions": {
		"target": "es2024",
		"module": "preserve",
		"jsx": "preserve",
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		]
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"app/**/*",
		"next-env.d.ts",
		"src/**/*",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
